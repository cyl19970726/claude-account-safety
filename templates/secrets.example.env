# 只放引用，不放明文。复制为 secrets.env 后加入 .gitignore。
# 本文件本身可以提交；真实 secrets.env 不可以。

# 1Password secret references
PROXY_PURCHASE_URL=op://Private/<provider>/purchase-url
PROXY_SUBSCRIPTION_URL=op://Private/<provider>/subscription-url
PROXY_ACCOUNT=op://Private/<provider>/account

# 或环境变量引用（值由 shell/secret manager 注入，不落盘）
# PROXY_SUBSCRIPTION_URL=env:PROXY_SUBSCRIPTION_URL

# 或 macOS Keychain 引用
# PROXY_SUBSCRIPTION_URL=keychain:claude-account-safety/proxy-subscription
